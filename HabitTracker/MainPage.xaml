<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:HabitTracker.Models"
             x:Class="HabitTracker.MainPage"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,Auto,*"
          RowSpacing="12"
          Padding="16">

        <!-- Строка 0: заголовок -->
        <VerticalStackLayout Grid.Row="0" Spacing="2">
            <Label Text="Habit Tracker"
                   FontSize="35"
                   FontFamily="OpenSansSemibold"
                   TextColor="#1E1E1E"
                   CharacterSpacing="0.5"
                   HorizontalTextAlignment="Center"
                   HorizontalOptions="Center"
                   Margin="0,5,0,8" />

            <Label Text="Список задач"
                   FontSize="30"
                   FontFamily="OpenSansSemibold"
                   TextColor="SteelBlue"
                   CharacterSpacing="0.5"
                   HorizontalTextAlignment="Center"
                   HorizontalOptions="Center"
                   Margin="0,1,0,10" />
        </VerticalStackLayout>

        <!-- Строка 1: ввод, кнопка, переключатель -->
        <VerticalStackLayout Grid.Row="1" Spacing="8">

            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <Entry x:Name="TaskEntry"
                       Grid.Column="0"
                       Placeholder="Введите задачу"
                       ReturnType="Done"
                       Completed="OnAddClicked" />
                <Button Grid.Column="1"
                        Text="Добавить"
                        BackgroundColor="#2563EB"
                        TextColor="#FFFFFF"
                        FontFamily="OpenSansSemibold"
                        CornerRadius="8"
                        Padding="16,0"
                        Clicked="OnAddClicked" />

            </Grid>


            <HorizontalStackLayout Spacing="8">
                <Switch x:Name="HideCompletedSwitch"
                        Toggled="OnHideCompletedToggled" />
                <Label Text="Скрыть выполненные"
                       TextColor="DarkSlateGray"
                       VerticalOptions="Center" />
            </HorizontalStackLayout>

        </VerticalStackLayout>

        <!-- Строка 2: список (одновременно область прокрутки) -->
        <CollectionView x:Name="TasksView"
                        Grid.Row="2"
                        SelectionMode="None">
            <!-- Шаблон элемента добавляется на шаге 4 -->
        </CollectionView>

    </Grid>
</ContentPage>